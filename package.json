{
  "name": "vmo-monaco-editor",
  "version": "0.1.6",
  "type": "module",
  "private": false,
  "description": "monaco editor vue3 component vscode",
  "main": "./dist/vmo-monaco-editor.umd.cjs",
  "module": "./dist/vmo-monaco-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vmo-monaco-editor.js",
      "require": "./dist/vmo-monaco-editor.umd.cjs"
    },
    "./*": "./*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "coverage": "node tests/coverage.mjs",
    "test:coverage:check": "node tests/coverage.mjs --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "monaco-editor": "^0.33.0",
    "ramda": "^0.30.1",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.10.4",
    "@types/ramda": "^0.30.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "autoprefixer": "^10.4.16",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.4",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-static-copy": "^1.0.6",
    "vitepress": "^1.6.4",
    "vue": "3.4.30",
    "vue-tsc": "^1.8.22"
  },
  "dependencies": {
    "markdown-it": "^15.0.2"
  }
}
